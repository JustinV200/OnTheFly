# Local backend configuration. SQLite is the default development database.
DATABASE_URL=sqlite:///./dev.db
TRANSACTION_SOURCE=fixture
STRIPE_SECRET_KEY=
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-opus-5
APP_VERSION=0.1.0
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Provider discovery: fixture (fictional demo providers), tavily (web search, needs TAVILY_API_KEY), or
# usaspending_tavily (public contract award recipients by UEI; TAVILY_API_KEY adds optional web enrichment).
DISCOVERY_SOURCE=fixture
TAVILY_API_KEY=
# Invitation channel: sandbox (stored in the sandbox outbox, no email leaves the machine) or smtp.
OUTREACH_CHANNEL=sandbox
OUTREACH_FROM_NAME=On the Fly
OUTREACH_FROM_EMAIL=invitations@onthefly.example
# The platform's physical postal address for the email footer. Required before smtp can send.
OUTREACH_POSTAL_ADDRESS=
PUBLIC_APP_BASE_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_STARTTLS=true
# Comma-separated exact recipient addresses smtp may send to. Empty: smtp sends nothing.
OUTREACH_RECIPIENT_ALLOWLIST=
