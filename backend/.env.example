# Local backend configuration. SQLite is the default development database.
DATABASE_URL=sqlite:///./dev.db
TRANSACTION_SOURCE=fixture
STRIPE_SECRET_KEY=
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-opus-5
# AI requirement drafting (the "Draft requirements with AI" panel). Empty key: drafting reports "not run" and entry
# stays manual. The model only drafts rows, tags and hours for the owner to confirm; it never prices anything.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
APP_VERSION=0.1.0
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Provider discovery: fixture (fictional demo providers), tavily (web search, needs TAVILY_API_KEY), or
# usaspending_tavily (public contract award recipients by UEI; TAVILY_API_KEY adds optional web enrichment).
DISCOVERY_SOURCE=fixture
TAVILY_API_KEY=
# Invitation channel: sandbox (stored in the sandbox outbox, no email leaves the machine) or smtp.
OUTREACH_CHANNEL=sandbox
OUTREACH_FROM_NAME=On the Fly
OUTREACH_FROM_EMAIL=invitations@onthefly.example
# The platform's physical postal address for the email footer. Required before smtp can send.
OUTREACH_POSTAL_ADDRESS=
PUBLIC_APP_BASE_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_STARTTLS=true
# Comma-separated exact recipient addresses smtp may send to. Empty: smtp sends nothing.
OUTREACH_RECIPIENT_ALLOWLIST=
# Task splitting: Ways to save suggests at most this many active pieces per task (manual splits are uncapped).
MAX_SUGGESTED_PIECES_PER_TASK=5
# Ways to save thresholds, printed on every card.
SAVINGS_MIN_BASIS_POINTS=1000
SAVINGS_MIN_ANNUAL_MINOR=2500000
SAVINGS_MIN_SUPPLIERS=3
SAVINGS_LOOKBACK_YEARS=5
# Market evidence: mock (labeled demo data) or live (public USAspending awards and subawards, no key needed;
# labor rates report "not checked" until a public rate client exists).
MARKET_DATA_SOURCE=mock
# Presenter controls for the GovCon task-chain demo (staging reseeds that chain). Set false on shared databases.
DEMO_CONTROLS_ENABLED=true
